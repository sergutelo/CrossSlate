+// ---- CrossSlate dashboard editor ----
+// CrossSlate (the other OTA slot's firmware) reads its dashboard content from
+// /crossslate/tasks.txt (one task per line, max 5 lines x 80 chars) and
+// /crossslate/pinned.txt (one line, max 160 chars). This firmware only edits
+// those files on the shared SD card; it never renders them on screen.
+
+namespace {
+constexpr const char* CROSSSLATE_DIR = "/crossslate";
+constexpr const char* CROSSSLATE_TASKS_PATH = "/crossslate/tasks.txt";
+constexpr const char* CROSSSLATE_TASKS_TMP_PATH = "/crossslate/tasks.tmp";
+constexpr const char* CROSSSLATE_PINNED_PATH = "/crossslate/pinned.txt";
+constexpr const char* CROSSSLATE_PINNED_TMP_PATH = "/crossslate/pinned.tmp";
+constexpr size_t CROSSSLATE_MAX_TASKS = 5;
+constexpr size_t CROSSSLATE_MAX_TASK_LEN = 80;  // per task, after trimming
+constexpr size_t CROSSSLATE_MAX_PINNED_LEN = 35;  // matches what the X4 dashboard can visibly render
+// Largest possible accepted payload: 5 tasks x 80 + newlines + pinned + slack.
+constexpr size_t CROSSSLATE_TEXT_BUF_LEN = 512;
+
+// Doodle canvas: a 1-bit monochrome BMP posted as a raw octet-stream body.
+constexpr const char* CROSSSLATE_DOODLE_PATH = "/crossslate/doodle.bmp";
+constexpr const char* CROSSSLATE_DOODLE_TMP_PATH = "/crossslate/doodle.tmp";
+// 400x500 lands around 25KB; the cap leaves headroom for the full 480x800
+// display (48KB) without letting an oversized body exhaust the heap.
+constexpr size_t CROSSSLATE_DOODLE_MAX_BODY = 96 * 1024;
+constexpr int32_t CROSSSLATE_DOODLE_MIN_DIM = 100;
+constexpr int32_t CROSSSLATE_DOODLE_MAX_WIDTH = 800;
+constexpr int32_t CROSSSLATE_DOODLE_MAX_HEIGHT = 1280;
+
+// Streaming state for the in-flight doodle upload (one request at a time,
+// same assumption as the font upload path). Kept out of the class so the
+// handlers stay const.
+struct CrossSlateDoodleUpload {
+  HalFile file;
+  bool valid = false;
+  bool headerChecked = false;
+  size_t bytesReceived = 0;
+  uint8_t header[30] = {0};  // must cover bpp at offsets 28-29
+  size_t headerLen = 0;
+};
+CrossSlateDoodleUpload doodleUpload;
+
+// Swap a fully written .tmp file over its final name using the proven
+// ClippingStore dance: SdFat's rename() fails when the destination exists, so
+// the current file goes to .bak first, the tmp is renamed into the freed slot,
+// then the backup is dropped. Restores the old content if the final rename
+// fails, so a torn write never leaves a half-file at the final path.
+bool renameTmpOverFinal(const char* tmpPath, const char* finalPath) {
+  char bakPath[64];
+  snprintf(bakPath, sizeof(bakPath), "%s.bak", finalPath);
+  const bool hadFinal = Storage.exists(finalPath);
+  if (hadFinal) {
+    if (Storage.exists(bakPath) && !Storage.remove(bakPath)) {
+      LOG_ERR("WEB", "CrossSlate save failed: cannot clear stale %s", bakPath);
+      Storage.remove(tmpPath);
+      return false;
+    }
+    if (!Storage.rename(finalPath, bakPath)) {
+      LOG_ERR("WEB", "CrossSlate save failed: cannot back up %s", finalPath);
+      Storage.remove(tmpPath);
+      return false;
+    }
+  }
+  if (!Storage.rename(tmpPath, finalPath)) {
+    LOG_ERR("WEB", "CrossSlate save failed: cannot rename %s to %s", tmpPath, finalPath);
+    Storage.remove(tmpPath);
+    if (hadFinal) Storage.rename(bakPath, finalPath);  // restore old content
+    return false;
+  }
+  if (hadFinal && Storage.exists(bakPath)) Storage.remove(bakPath);
+  return true;
+}
+
+// Crash-atomic small-file write: stream the data to .tmp, close it (only one
+// reader may hold a file open), then swap it over the final name.
+bool writeTmpAndRename(const char* tmpPath, const char* finalPath, const char* data, size_t len) {
+  HalFile file;
+  if (!Storage.openFileForWrite("WEB", tmpPath, file)) {
+    LOG_ERR("WEB", "CrossSlate save failed: cannot open %s", tmpPath);
+    return false;
+  }
+  const size_t written = file.write(data, len);
+  file.close();
+  if (written != len) {
+    LOG_ERR("WEB", "CrossSlate save failed: short write to %s (%u/%u)", tmpPath, written, static_cast<unsigned>(len));
+    Storage.remove(tmpPath);
+    return false;
+  }
+  return renameTmpOverFinal(tmpPath, finalPath);
+}
+}  // namespace
+
+void CrossPointWebServer::handleCrossSlatePage() const {
+  sendHtmlContent(server.get(), CrossSlatePageHtml, sizeof(CrossSlatePageHtml));
+}
+
+void CrossPointWebServer::handleCrossSlateGet() const {
+  // Stack buffer sized for the accepted payload (<= 512B): avoids heap churn on
+  // a lightweight GET that only fills a small JSON document.
+  char tasksBuf[CROSSSLATE_TEXT_BUF_LEN] = {0};
+  char pinnedBuf[CROSSSLATE_MAX_PINNED_LEN + 1] = {0};
+
+  // Missing files mean "nothing configured yet" — serve empty fields so the
+  // browser can save an initial set. Only I/O errors are logged.
+  const size_t tasksLen = Storage.readFileToBuffer(CROSSSLATE_TASKS_PATH, tasksBuf, sizeof(tasksBuf));
+  const size_t pinnedLen = Storage.readFileToBuffer(CROSSSLATE_PINNED_PATH, pinnedBuf, sizeof(pinnedBuf));
+  tasksBuf[tasksLen] = '\0';
+  pinnedBuf[pinnedLen] = '\0';
+
+  JsonDocument doc;
+  JsonArray tasks = doc["tasks"].to<JsonArray>();
+  size_t count = 0;
+  char* line = tasksBuf;
+  while (line && count < CROSSSLATE_MAX_TASKS) {
+    char* end = strchr(line, '\n');
+    if (end) {
+      *end = '\0';
+    }
+    // Trim whitespace the same way CrossSlate's parser does.
+    while (*line && isspace(static_cast<unsigned char>(*line))) {
+      line++;
+    }
+    char* lineEnd = line + strlen(line);
+    while (lineEnd > line && isspace(static_cast<unsigned char>(lineEnd[-1]))) {
+      lineEnd--;
+      *lineEnd = '\0';
+    }
+    if (*line) {
+      char capped[CROSSSLATE_MAX_TASK_LEN + 1] = {0};
+      snprintf(capped, sizeof(capped), "%s", line);
+      tasks.add(capped);
+      count++;
+    }
+    line = end ? end + 1 : nullptr;
+  }
+  char pinnedCapped[CROSSSLATE_MAX_PINNED_LEN + 1] = {0};
+  snprintf(pinnedCapped, sizeof(pinnedCapped), "%s", pinnedBuf);
+  doc["pinned"] = pinnedCapped;
+  doc["doodle"] = Storage.exists(CROSSSLATE_DOODLE_PATH);
+  doc["doodleTmp"] = Storage.exists(CROSSSLATE_DOODLE_TMP_PATH);
+
+  String response;
+  serializeJson(doc, response);
+  server->send(200, "application/json", response);
+}
+
+void CrossPointWebServer::handleCrossSlateSave() const {
+  if (!server->hasArg("plain")) {
+    server->send(400, "application/json", "{\"error\":\"Missing JSON body\"}");
+    return;
+  }
+
+  const String body = server->arg("plain");
+  JsonDocument doc;
+  const DeserializationError err = deserializeJson(doc, body);
+  if (err) {
+    server->send(400, "application/json", "{\"error\":\"Invalid JSON\"}");
+    return;
+  }
+
+  // Validate tasks: max 5 non-empty lines, 80 chars each after trimming.
+  // Accept the raw multiline textarea value as either a single JSON string
+  // (what the bundled page sends) or a pre-split array.
+  JsonArrayConst tasksIn = doc["tasks"].as<JsonArrayConst>();
+  const bool tasksIsString = doc["tasks"].is<const char*>();
+  if (tasksIn.isNull() && !tasksIsString) {
+    server->send(400, "application/json", "{\"error\":\"Missing tasks\"}");
+    return;
+  }
+  char tasksBuf[CROSSSLATE_TEXT_BUF_LEN];
+  size_t tasksPos = 0;
+  size_t taskCount = 0;
+  auto appendTask = [&](const char* raw) -> bool {
+    // Trim leading/trailing whitespace the same way CrossSlate's parser does.
+    const char* begin = raw;
+    while (*begin && isspace(static_cast<unsigned char>(*begin))) {
+      begin++;
+    }
+    const char* end = begin + strlen(begin);
+    while (end > begin && isspace(static_cast<unsigned char>(end[-1]))) {
+      end--;
+    }
+    if (begin == end) {
+      return true;  // skip empty lines entirely
+    }
+    if (taskCount >= CROSSSLATE_MAX_TASKS) {
+      return false;
+    }
+    if (static_cast<size_t>(end - begin) > CROSSSLATE_MAX_TASK_LEN) {
+      return false;
+    }
+    if (tasksPos + (end - begin) + 1 >= sizeof(tasksBuf)) {
+      return false;
+    }
+    memcpy(tasksBuf + tasksPos, begin, end - begin);
+    tasksPos += end - begin;
+    tasksBuf[tasksPos++] = '\n';
+    taskCount++;
+    return true;
+  };
+
+  bool valid = true;
+  if (doc["tasks"].is<const char*>()) {
+    const char* text = doc["tasks"].as<const char*>();
+    const char* line = text;
+    while (valid && line) {
+      const char* end = strchr(line, '\n');
+      if (end) {
+        const size_t len = static_cast<size_t>(end - line);
+        // Generous staging buffer so over-length raw lines (e.g. long runs of
+        // leading whitespace) reach appendTask and get judged after trimming.
+        char single[256];
+        if (len >= sizeof(single)) {
+          valid = false;
+          break;
+        }
+        memcpy(single, line, len);
+        single[len] = '\0';
+        valid = appendTask(single);
+        line = end + 1;
+      } else {
+        valid = appendTask(line);
+        line = nullptr;
+      }
+    }
+  } else {
+    for (JsonVariantConst t : tasksIn) {
+      if (!t.is<const char*>() || !appendTask(t.as<const char*>())) {
+        valid = false;
+        break;
+      }
+    }
+  }
+
+  const char* pinnedRaw = doc["pinned"] | "";
+  if (strlen(pinnedRaw) > CROSSSLATE_MAX_PINNED_LEN || strchr(pinnedRaw, '\n') != nullptr ||
+      strchr(pinnedRaw, '\r') != nullptr) {
+    server->send(400, "application/json",
+                 "{\"error\":\"Pinned note must be a single line of at most 160 characters\"}");
+    return;
+  }
+
+  if (!valid) {
+    server->send(400, "application/json", "{\"error\":\"Tasks must be at most 5 non-empty lines of 80 characters\"}");
+    return;
+  }
+
+  if (!Storage.ready()) {
+    LOG_ERR("WEB", "CrossSlate save failed: SD storage not ready");
+    server->send(500, "application/json", "{\"error\":\"SD storage not ready\"}");
+    return;
+  }
+
+  if (!Storage.exists(CROSSSLATE_DIR) && !Storage.mkdir(CROSSSLATE_DIR)) {
+    LOG_ERR("WEB", "CrossSlate save failed: cannot create %s", CROSSSLATE_DIR);
+    server->send(500, "application/json", "{\"error\":\"Cannot create /crossslate directory\"}");
+    return;
+  }
+
+  // Write .tmp then rename — the same crash-atomic pattern CrossSlate itself
+  // uses, and required because both firmwares share this SD card. The shared
+  // namespace helper implements the proven ClippingStore dance (see above).
+
+  // Serialize both files up front so validation failures cannot leave a
+  // half-updated pair behind.
+  char pinnedBuf[CROSSSLATE_MAX_PINNED_LEN + 2];
+  const size_t pinnedLen = snprintf(pinnedBuf, sizeof(pinnedBuf), "%s\n", pinnedRaw);
+
+  if (!writeTmpAndRename(CROSSSLATE_TASKS_TMP_PATH, CROSSSLATE_TASKS_PATH, tasksBuf, tasksPos)) {
+    server->send(500, "application/json", "{\"error\":\"Failed to write tasks.txt\"}");
+    return;
+  }
+  if (!writeTmpAndRename(CROSSSLATE_PINNED_TMP_PATH, CROSSSLATE_PINNED_PATH, pinnedBuf, pinnedLen)) {
+    server->send(500, "application/json", "{\"error\":\"Failed to write pinned.txt\"}");
+    return;
+  }
+
+  LOG_INF("WEB", "CrossSlate saved %u tasks + pinned note", static_cast<unsigned>(taskCount));
+  server->send(200, "application/json", "{\"ok\":true}");
+}
+
+// ---- CrossSlate doodle upload ----
+// The browser turns the canvas into a 1-bit monochrome BMP and POSTs it as a
+// raw octet-stream body. It is streamed to /crossslate/doodle.tmp (never
+// directly to the final path: both firmwares share this SD card, so a torn
+// write must never look like valid content) and swapped into place atomically
+// in the POST completion handler.
+
+void CrossPointWebServer::handleCrossSlateDoodleData() const {
+  HTTPUpload& upload = server->upload();
+
+  switch (upload.status) {
+    case UPLOAD_FILE_START: {
+      doodleUpload.file = HalFile();
+      doodleUpload.valid = false;
+      doodleUpload.headerChecked = false;
+      doodleUpload.bytesReceived = 0;
+      doodleUpload.headerLen = 0;
+
+      if (!Storage.ready()) {
+        LOG_ERR("WEB", "Doodle upload failed: SD storage not ready");
+        break;
+      }
+      if (!Storage.exists(CROSSSLATE_DIR) && !Storage.mkdir(CROSSSLATE_DIR)) {
+        LOG_ERR("WEB", "Doodle upload failed: cannot create %s", CROSSSLATE_DIR);
+        break;
+      }
+      if (!Storage.openFileForWrite("WEB", CROSSSLATE_DOODLE_TMP_PATH, doodleUpload.file)) {
+        LOG_ERR("WEB", "Doodle upload failed: cannot open %s", CROSSSLATE_DOODLE_TMP_PATH);
+        break;
+      }
+      doodleUpload.valid = true;
+      LOG_INF("WEB", "Doodle upload: started");
+      break;
+    }
+
+    case UPLOAD_FILE_WRITE: {
+      if (!doodleUpload.valid) break;
+
+      // Multipart chunks may split the 26-byte BMP header across chunks, so
+      // stage the first 26 bytes before validating. Reading upload.buf directly
+      // after an accumulated-size check would inspect the wrong bytes.
+      if (!doodleUpload.headerChecked) {
+        const size_t need = sizeof(doodleUpload.header);  // 30: BMP fields through bpp
+        const size_t toCopy = (upload.currentSize < need - doodleUpload.headerLen)
+                                  ? upload.currentSize
+                                  : need - doodleUpload.headerLen;
+        if (toCopy > 0) {
+          memcpy(doodleUpload.header + doodleUpload.headerLen, upload.buf, toCopy);
+          doodleUpload.headerLen += toCopy;
+        }
+        if (doodleUpload.headerLen < need) break;  // wait for more chunks
+        doodleUpload.headerChecked = true;
+        const uint8_t* hdr = doodleUpload.header;
+        const bool okMagic = hdr[0] == 'B' && hdr[1] == 'M';
+        const uint16_t bpp = static_cast<uint16_t>(hdr[28]) | (static_cast<uint16_t>(hdr[29]) << 8);
+        const int32_t width = static_cast<int32_t>(hdr[18]) | (static_cast<int32_t>(hdr[19]) << 8) |
+                              (static_cast<int32_t>(hdr[20]) << 16) | (static_cast<int32_t>(hdr[21]) << 24);
+        const int32_t height = static_cast<int32_t>(hdr[22]) | (static_cast<int32_t>(hdr[23]) << 8) |
+                               (static_cast<int32_t>(hdr[24]) << 16) | (static_cast<int32_t>(hdr[25]) << 24);
+        if (!okMagic || bpp != 1 || width < CROSSSLATE_DOODLE_MIN_DIM || width > CROSSSLATE_DOODLE_MAX_WIDTH ||
+            height < CROSSSLATE_DOODLE_MIN_DIM || height > CROSSSLATE_DOODLE_MAX_HEIGHT) {
+          LOG_ERR("WEB", "Doodle upload failed: bad BMP header (bpp=%u, %ldx%ld)", bpp,
+                  static_cast<long>(width), static_cast<long>(height));
+          doodleUpload.file.close();
+          doodleUpload.valid = false;
+          break;
+        }
+      }
+
+      doodleUpload.bytesReceived += upload.currentSize;
+      if (doodleUpload.bytesReceived > CROSSSLATE_DOODLE_MAX_BODY) {
+        LOG_ERR("WEB", "Doodle upload failed: body exceeds %u bytes", static_cast<unsigned>(CROSSSLATE_DOODLE_MAX_BODY));
+        doodleUpload.file.close();
+        doodleUpload.valid = false;
+        break;
+      }
+
+      if (doodleUpload.file.write(upload.buf, upload.currentSize) != upload.currentSize) {
+        LOG_ERR("WEB", "Doodle upload failed: short write to %s", CROSSSLATE_DOODLE_TMP_PATH);
+        doodleUpload.file.close();
+        doodleUpload.valid = false;
+      }
+      break;
+    }
+
+    case UPLOAD_FILE_END: {
+      LOG_INF("WEB", "Doodle upload: end, valid=%d bytes=%u headerChecked=%d", doodleUpload.valid,
+              static_cast<unsigned>(doodleUpload.bytesReceived), doodleUpload.headerChecked);
+      if (doodleUpload.file.isOpen()) {
+        doodleUpload.file.close();
+      }
+      if (doodleUpload.valid) {
+        // Swap the tmp over the final path using the shared atomic pattern.
+        if (renameTmpOverFinal(CROSSSLATE_DOODLE_TMP_PATH, CROSSSLATE_DOODLE_PATH)) {
+          LOG_INF("WEB", "Doodle saved: %u bytes", static_cast<unsigned>(doodleUpload.bytesReceived));
+        } else {
+          doodleUpload.valid = false;
+        }
+      }
+      if (!doodleUpload.valid) {
+        Storage.remove(CROSSSLATE_DOODLE_TMP_PATH);
+      }
+      break;
+    }
+
+    case UPLOAD_FILE_ABORTED: {
+      if (doodleUpload.file.isOpen()) {
+        doodleUpload.file.close();
+      }
+      Storage.remove(CROSSSLATE_DOODLE_TMP_PATH);
+      doodleUpload.valid = false;
+      LOG_ERR("WEB", "Doodle upload aborted");
+      break;
+    }
+  }
+}
+
+void CrossPointWebServer::handleCrossSlateDoodlePost() const {
+  // Run after the streaming callback: doodleUpload.valid reflects the outcome.
+  if (doodleUpload.valid) {
+    doodleUpload.valid = false;
+    server->send(200, "application/json", "{\"ok\":true}");
+  } else {
+    server->send(400, "application/json",
+                 "{\"error\":\"Invalid doodle: expected a 1-bit BMP body of at most 96KB\"}");
+  }
+}
+
+void CrossPointWebServer::handleCrossSlateDoodleDebug() const {
+  // Temporary diagnostics: recent log lines + doodle file state, so upload
+  // failures are visible from the browser without a serial cable.
+  const std::string logs = getLastLogs();
+  String body;
+  body += "{\"doodle\":";
+  body += Storage.exists(CROSSSLATE_DOODLE_PATH) ? "true" : "false";
+  body += ",\"doodleTmp\":";
+  body += Storage.exists(CROSSSLATE_DOODLE_TMP_PATH) ? "true" : "false";
+  body += ",\"log\":";
+  // JSON-escape: logs contain quotes/backslashes rarely; escape both + newlines.
+  body += "\"";
+  for (const char c : logs) {
+    switch (c) {
+      case '"': body += "\\\""; break;
+      case '\\': body += "\\\\"; break;
+      case '\n': body += "\\n"; break;
+      case '\r': break;
+      default: body += c; break;
+    }
+  }
+  body += "\"}";
+  server->send(200, "application/json", body);
+}
+
+void CrossPointWebServer::handleCrossSlateDoodleDelete() const {
+  if (!Storage.ready()) {
+    LOG_ERR("WEB", "Doodle delete failed: SD storage not ready");
+    server->send(500, "application/json", "{\"error\":\"SD storage not ready\"}");
+    return;
+  }
+  bool removed = true;
+  if (Storage.exists(CROSSSLATE_DOODLE_PATH) && !Storage.remove(CROSSSLATE_DOODLE_PATH)) {
+    LOG_ERR("WEB", "Doodle delete failed: cannot remove %s", CROSSSLATE_DOODLE_PATH);
+    removed = false;
+  }
+  if (!removed) {
+    server->send(500, "application/json", "{\"error\":\"Failed to delete doodle\"}");
+    return;
+  }
+  server->send(200, "application/json", "{\"ok\":true}");
+}
