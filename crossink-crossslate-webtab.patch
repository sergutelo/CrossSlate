+// Returns the other OTA slot only when it contains a plausible app image for
+// the same chip and a valid ESP app description. The runtime full-image
+// verifier cannot be used for our patched X3/X4 images; see the note above.
+const esp_partition_t* findValidAlternateApp();
+
 }  // namespace ota_boot
