+void HomeActivity::onOpenCrossSlate() {
+#ifndef SIMULATOR
+  auto confirmation = makeUniqueNoThrow<ConfirmationActivity>(renderer, mappedInput, tr(STR_OPEN_CROSSSLATE),
+                                                              tr(STR_OPEN_CROSSSLATE_CONFIRM));
+  if (!confirmation) {
+    LOG_ERR("HOME", "OOM: CrossSlate confirmation");
+    requestUpdate();
+    return;
+  }
+  startActivityForResult(std::move(confirmation), [this](const ActivityResult& result) {
+    if (result.isCancelled) {
+      requestUpdate();
+      return;
+    }
+    const esp_partition_t* target = ota_boot::findValidAlternateApp();
+    if (target == nullptr || !ota_boot::switchTo(target)) {
+      LOG_ERR("HOME", "failed to switch to CrossSlate OTA app");
+      hasCrossSlate = false;
+      requestUpdate();
+      return;
+    }
+    ESP.restart();
+  });
+#endif
+}
+
 void HomeActivity::onFileTransferOpen() { activityManager.goToFileTransfer(); }
 
