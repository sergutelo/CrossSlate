diff --git a/web/pages/crossslate.js b/web/pages/crossslate.js
new file mode 100644
index 0000000..25d3ceb
--- /dev/null
+++ b/web/pages/crossslate.js
@@ -0,0 +1,480 @@
+const MAX_TASKS = 5;
+  const MAX_TASK_LEN = 80;
+  const MAX_PINNED_LEN = 35;
+
+  function showMessage(text, isError) {
+    const msg = document.getElementById('message');
+    msg.textContent = text;
+    msg.className = 'message ' + (isError ? 'error' : 'success');
+    msg.style.display = 'block';
+    setTimeout(function() { msg.style.display = 'none'; }, 4000);
+  }
+
+  function updateCount() {
+    const lines = document.getElementById('tasks').value.split('\n');
+    const el = document.getElementById('taskCount');
+    if (lines.length > MAX_TASKS) {
+      el.textContent = lines.length + ' lines — too many (max ' + MAX_TASKS + ')';
+    } else {
+      const over = lines.filter(function(l) { return l.length > MAX_TASK_LEN; }).length;
+      el.textContent = lines.length + ' / ' + MAX_TASKS + ' lines' +
+        (over ? ' — ' + over + ' line(s) over ' + MAX_TASK_LEN + ' chars' : '');
+    }
+  }
+
+  async function loadCrossSlate() {
+    try {
+      const res = await fetch('/api/crossslate');
+      const data = await res.json();
+      document.getElementById('tasks').value = (data.tasks || []).join('\n');
+      document.getElementById('pinned').value = data.pinned || '';
+      updateCount();
+      updateDoodleStatus(!!data.doodle, !!data.doodleTmp);
+    } catch (e) {
+      showMessage('Failed to load CrossSlate data', true);
+    }
+  }
+
+  async function saveCrossSlate() {
+    const body = JSON.stringify({
+      tasks: document.getElementById('tasks').value,
+      pinned: document.getElementById('pinned').value
+    });
+    try {
+      const res = await fetch('/api/crossslate/save', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: body
+      });
+      const data = await res.json().catch(function() { return {}; });
+      if (res.ok) {
+        showMessage('Saved', false);
+        // Re-sync the textarea with what the device accepted (trimming etc.)
+        loadCrossSlate();
+      } else {
+        showMessage(data.error || 'Save failed', true);
+      }
+    } catch (e) {
+      showMessage('Save failed', true);
+    }
+  }
+
+  document.getElementById('tasks').addEventListener('input', updateCount);
+  loadCrossSlate();
+
+  // ---- Doodle canvas ----
+
+  const canvas = document.getElementById('doodleCanvas');
+  const ctx = canvas.getContext('2d', { willReadFrequently: true });
+
+  function clearDoodle() {
+    // Transparent background (not white): lets sendDoodle() composite the
+    // user's ink over the selected frame without white pixels erasing it.
+    ctx.clearRect(0, 0, canvas.width, canvas.height);
+  }
+  clearDoodle();
+
+  let drawing = false;
+  let lastX = 0, lastY = 0;
+
+  // Stroke history for undo: snapshot the bitmap after each completed stroke.
+  // 456x270 1-bit ~15.4KB per snapshot; cap at 10 (browser-side only).
+  const history = [];
+  const HISTORY_MAX = 10;
+
+  function snapshot() {
+    if (history.length >= HISTORY_MAX) history.shift();
+    history.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
+  }
+
+  function undoStroke() {
+    if (!history.length) return;
+    ctx.putImageData(history.pop(), 0, 0);
+  }
+
+
+  function canvasPos(ev) {
+    const r = canvas.getBoundingClientRect();
+    return {
+      x: (ev.clientX - r.left) * (canvas.width / r.width),
+      y: (ev.clientY - r.top) * (canvas.height / r.height)
+    };
+  }
+
+  canvas.addEventListener('pointerdown', function(ev) {
+    ev.preventDefault();
+    canvas.setPointerCapture(ev.pointerId);
+    drawing = true;
+    snapshot();
+    const p = canvasPos(ev);
+    lastX = p.x; lastY = p.y;
+    // Draw a dot for a simple tap.
+    ctx.beginPath();
+    ctx.arc(lastX, lastY, 1.5, 0, Math.PI * 2);
+    ctx.fillStyle = '#000';
+    ctx.fill();
+  });
+
+  canvas.addEventListener('pointermove', function(ev) {
+    if (!drawing) return;
+    ev.preventDefault();
+    const p = canvasPos(ev);
+    ctx.beginPath();
+    ctx.moveTo(lastX, lastY);
+    ctx.lineTo(p.x, p.y);
+    ctx.strokeStyle = '#000';
+    ctx.lineWidth = 3;
+    ctx.lineCap = 'round';
+    ctx.lineJoin = 'round';
+    ctx.stroke();
+    lastX = p.x; lastY = p.y;
+  });
+
+  function endStroke(ev) {
+    drawing = false;
+    if (ev && canvas.hasPointerCapture && canvas.hasPointerCapture(ev.pointerId)) {
+      canvas.releasePointerCapture(ev.pointerId);
+    }
+  }
+  document.getElementById('undoBtn').addEventListener('click', undoStroke);
+  document.getElementById('clearBtn').addEventListener('click', function() { history.length = 0; clearDoodle(); });
+
+  canvas.addEventListener('pointerup', endStroke);
+  canvas.addEventListener('pointercancel', endStroke);
+
+  // Build a 1-bit monochrome BMP (bottom-up rows, 4-byte aligned) entirely in
+  // the browser: ~28.5KB at 456x500, well within the 96KB body cap. The native
+  // resolution matches the X4 dashboard band so the device renders 1:1.
+
+  // ---- Decorative hand-drawn frames ----
+  // Each painter draws a rectangular frame inside a 2D context using normalized
+  // coordinates (0..1), so the same function renders both the 456x500 canvas
+  // and the tiny thumbnails. All strokes are solid black, thick enough to
+  // survive 1-bit e-ink thresholding.
+  const FRAMES = [
+    { name: 'None', paint: null },
+    { name: 'Sketch', paint: paintFrameSketch },
+    { name: 'Loops', paint: paintFrameLoops },
+    { name: 'Hatched', paint: paintFrameHatch },
+    { name: 'Curls', paint: paintFrameCurls },
+    { name: 'Ticks', paint: paintFrameTicks },
+    { name: 'Scallop', paint: paintFrameScallop },
+    { name: 'Doble', paint: paintFrameDouble }
+  ];
+  let selectedFrame = 0;
+
+  function framePaint(ctx2, w, h) {
+    const f = FRAMES[selectedFrame];
+    if (f && f.paint) f.paint(ctx2, w, h);
+  }
+
+  function paintFrameSketch(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    ctx2.lineWidth = 4;
+    ctx2.lineCap = 'round';
+    // 3 wobbly passes with jittered corners sticking out
+    const passes = [
+      { d: 0,  j: 6 },
+      { d: 5,  j: 9 },
+      { d: -4, j: 7 }
+    ];
+    for (const p of passes) {
+      const x0 = 14 + p.d + (Math.sin(w) > 0 ? 2 : -2);
+      const y0 = 14 + p.d;
+      const x1 = w - 14 + p.d;
+      const y1 = h - 14 + p.d;
+      ctx2.beginPath();
+      ctx2.moveTo(x0 - p.j, y0 + 10);
+      ctx2.lineTo(x0 + (x1-x0)*0.3 + 3, y0 - 2);
+      ctx2.lineTo(x0 + (x1-x0)*0.6 - 3, y0 + 3);
+      ctx2.lineTo(x1 + p.j, y0 + 8);
+      ctx2.lineTo(x1 + 2, y0 + (y1-y0)*0.5);
+      ctx2.lineTo(x1 - 3, y1 + 2);
+      ctx2.lineTo(x0 + (x1-x0)*0.4, y1 - 2);
+      ctx2.lineTo(x0 - p.j, y1 + 4);
+      ctx2.lineTo(x0 - 2, y0 + (y1-y0)*0.4);
+      ctx2.closePath();
+      ctx2.stroke();
+    }
+  }
+
+  function paintFrameLoops(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    ctx2.lineWidth = 4;
+    ctx2.lineCap = 'round';
+    const m = 26;              // margin
+    const r = 11;              // loop radius
+    const inset = m + r;
+    ctx2.beginPath();
+    // top: loops left->right
+    for (let x = inset; x < w - inset; x += r * 2) {
+      ctx2.moveTo(x, m);
+      ctx2.arc(x + r, m, r, Math.PI, 0, false);
+    }
+    // right: loops top->bottom
+    for (let y = inset; y < h - inset; y += r * 2) {
+      ctx2.moveTo(w - m, y);
+      ctx2.arc(w - m, y + r, r, -Math.PI/2, Math.PI/2, false);
+    }
+    // bottom: loops right->left
+    for (let x = w - inset; x > inset; x -= r * 2) {
+      ctx2.moveTo(x, h - m);
+      ctx2.arc(x - r, h - m, r, 0, Math.PI, false);
+    }
+    // left: loops bottom->top
+    for (let y = h - inset; y > inset; y -= r * 2) {
+      ctx2.moveTo(m, y);
+      ctx2.arc(m, y - r, r, Math.PI/2, -Math.PI/2, false);
+    }
+    ctx2.stroke();
+  }
+
+  function paintFrameHatch(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    // outer thick
+    ctx2.lineWidth = 7;
+    ctx2.strokeRect(12, 12, w - 24, h - 24);
+    // inner thin
+    ctx2.lineWidth = 3;
+    ctx2.strokeRect(30, 30, w - 60, h - 60);
+    // diagonal hatching between the two rectangles
+    ctx2.lineWidth = 2;
+    ctx2.save();
+    ctx2.beginPath();
+    // clip band between rects
+    ctx2.rect(0, 0, w, h);
+    ctx2.rect(30, 30, w - 60, h - 60);
+    ctx2.clip('evenodd');
+    ctx2.beginPath();
+    for (let d = -h; d < w + h; d += 14) {
+      ctx2.moveTo(d, 0);
+      ctx2.lineTo(d + h, h);
+    }
+    ctx2.stroke();
+    ctx2.restore();
+  }
+
+  function paintFrameCurls(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    ctx2.lineWidth = 4;
+    ctx2.strokeRect(16, 16, w - 32, h - 32);
+    // curls at each corner (bezier volutes)
+    const c = 34;
+    const corners = [
+      [16, 16, 1, 1], [w - 16, 16, -1, 1],
+      [16, h - 16, 1, -1], [w - 16, h - 16, -1, -1]
+    ];
+    for (const [cx, cy, sx, sy] of corners) {
+      ctx2.beginPath();
+      ctx2.moveTo(cx + sx * c, cy + sy * 6);
+      ctx2.bezierCurveTo(cx + sx * c * 0.5, cy + sy * c * 0.9,
+                         cx + sx * 6, cy + sy * c * 0.5,
+                         cx + sx * 8, cy + sy * c);
+      ctx2.stroke();
+      ctx2.beginPath();
+      ctx2.arc(cx + sx * c * 0.45, cy + sy * c * 0.45, 7, 0, Math.PI * 2);
+      ctx2.stroke();
+    }
+  }
+
+  function paintFrameTicks(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    ctx2.lineWidth = 3;
+    ctx2.strokeRect(22, 22, w - 44, h - 44);
+    // perpendicular ticks pointing outward every ~36px
+    ctx2.lineWidth = 4;
+    ctx2.beginPath();
+    for (let x = 34; x < w - 22; x += 36) {
+      ctx2.moveTo(x, 22); ctx2.lineTo(x, 10);
+      ctx2.moveTo(x, h - 22); ctx2.lineTo(x, h - 10);
+    }
+    for (let y = 34; y < h - 22; y += 36) {
+      ctx2.moveTo(22, y); ctx2.lineTo(10, y);
+      ctx2.moveTo(w - 22, y); ctx2.lineTo(w - 10, y);
+    }
+    ctx2.stroke();
+  }
+
+  function paintFrameScallop(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    ctx2.lineWidth = 4;
+    const r = 12;
+    const m = 24;
+    // scallops along each side: semicircles bulging outward
+    ctx2.beginPath();
+    for (let x = m; x + r * 2 <= w - m + 1; x += r * 2) {
+      ctx2.moveTo(x + r * 2, m);
+      ctx2.arc(x + r, m, r, 0, Math.PI, true);
+    }
+    for (let x = m; x + r * 2 <= w - m + 1; x += r * 2) {
+      ctx2.moveTo(x, h - m);
+      ctx2.arc(x + r, h - m, r, Math.PI, 0, true);
+    }
+    for (let y = m; y + r * 2 <= h - m + 1; y += r * 2) {
+      ctx2.moveTo(m, y + r * 2);
+      ctx2.arc(m, y + r, r, Math.PI/2, -Math.PI/2, true);
+    }
+    for (let y = m; y + r * 2 <= h - m + 1; y += r * 2) {
+      ctx2.moveTo(w - m, y);
+      ctx2.arc(w - m, y + r, r, -Math.PI/2, Math.PI/2, true);
+    }
+    ctx2.stroke();
+  }
+
+  function paintFrameDouble(ctx2, w, h) {
+    ctx2.strokeStyle = '#000';
+    ctx2.lineWidth = 5;
+    ctx2.strokeRect(14, 14, w - 28, h - 28);
+    ctx2.lineWidth = 2;
+    ctx2.strokeRect(26, 26, w - 52, h - 52);
+    // small circles at the 4 corners between both lines
+    const cs = [
+      [20, 20], [w - 20, 20], [20, h - 20], [w - 20, h - 20]
+    ];
+    for (const [cx, cy] of cs) {
+      ctx2.beginPath();
+      ctx2.arc(cx, cy, 8, 0, Math.PI * 2);
+      ctx2.stroke();
+    }
+  }
+
+  // Build thumbnails + selection behavior
+  function buildFramePicker() {
+    const row = document.getElementById('frameRow');
+    FRAMES.forEach(function(f, idx) {
+      const wrap = document.createElement('div');
+      wrap.className = 'frame-thumb' + (idx === selectedFrame ? ' selected' : '');
+      const tc = document.createElement('canvas');
+      tc.width = 90; tc.height = 98;
+      const tctx = tc.getContext('2d');
+      tctx.fillStyle = '#fff';
+      tctx.fillRect(0, 0, 90, 98);
+      tctx.strokeStyle = '#000';
+      // mini inner rect hint of the drawing area
+      tctx.lineWidth = 1;
+      tctx.strokeRect(24, 26, 42, 46);
+      if (f.paint) f.paint(tctx, 90, 98);
+      wrap.appendChild(tc);
+      wrap.addEventListener('click', function() {
+        selectedFrame = idx;
+        document.querySelectorAll('.frame-thumb').forEach(function(el) {
+          el.classList.remove('selected');
+        });
+        wrap.classList.add('selected');
+        document.getElementById('frameName').textContent = 'Frame: ' + f.name;
+      });
+      row.appendChild(wrap);
+    });
+  }
+  buildFramePicker();
+
+  function canvasToMonoBmp(srcCanvas) {
+    const w = srcCanvas.width, h = srcCanvas.height;
+    const rowBytes = Math.ceil(w / 32) * 4;  // 32 pixels per 4-byte row unit
+    const pixelBytes = rowBytes * h;
+    const fileSize = 14 + 40 + 8 + pixelBytes;  // file hdr + info hdr + palette
+
+    const buf = new ArrayBuffer(fileSize);
+    const dv = new DataView(buf);
+    const u8 = new Uint8Array(buf);
+
+    // BITMAPFILEHEADER (14 bytes)
+    u8[0] = 0x42; u8[1] = 0x4D;  // 'BM'
+    dv.setUint32(2, fileSize, true);
+    dv.setUint32(10, 14 + 40 + 8, true);  // pixel data offset
+
+    // BITMAPINFOHEADER (40 bytes)
+    dv.setUint32(14, 40, true);
+    dv.setInt32(18, w, true);
+    dv.setInt32(22, h, true);
+    dv.setUint16(26, 1, true);   // planes
+    dv.setUint16(28, 1, true);   // bpp = 1
+    dv.setUint32(30, 0, true);   // BI_RGB
+    dv.setUint32(34, pixelBytes, true);
+    dv.setUint32(46, 2, true);  // biClrUsed: the device decoder only loads the palette when colorsUsed > 0
+
+    // Palette: index 0 = white, index 1 = black
+    dv.setUint32(54, 0x00FFFFFF, true);
+    dv.setUint32(58, 0x00000000, true);
+
+    // Pixel data, bottom-up. In BMP 1-bit, a set bit = palette index 1 = black.
+    const img = srcCanvas.getContext('2d', { willReadFrequently: true }).getImageData(0, 0, w, h).data;
+    for (let y = 0; y < h; y++) {
+      const srcRow = (h - 1 - y) * w;          // bottom-up
+      const dstOff = 14 + 40 + 8 + y * rowBytes;
+      for (let x = 0; x < w; x++) {
+        const i = (srcRow + x) * 4;
+        // Luminance threshold: dark opaque pixels become ink (bit set).
+        // Transparent pixels (alpha < 128) count as white background.
+        const lum = 0.299 * img[i] + 0.587 * img[i + 1] + 0.114 * img[i + 2];
+        if (img[i + 3] >= 128 && lum < 128) {
+          u8[dstOff + (x >> 3)] |= (0x80 >> (x & 7));
+        }
+      }
+    }
+    return u8;
+  }
+
+  function updateDoodleStatus(exists, hasTmp) {
+    let text = 'Last doodle on X4: ' + (exists ? 'yes' : 'no');
+    if (hasTmp) text += ' | stale .tmp present (upload failed mid-way)';
+    const el = document.getElementById('doodleStatus');
+    el.textContent = text;
+    console.log('[crossslate]', text);
+  }
+
+  async function sendDoodle() {
+    let source = canvas;
+    if (selectedFrame !== 0) {
+      // Compose: frame first, then the user's drawing on top. The working
+      // canvas stays untouched so frames can be swapped freely.
+      const tmp = document.createElement('canvas');
+      tmp.width = canvas.width;
+      tmp.height = canvas.height;
+      const tctx = tmp.getContext('2d');
+      tctx.fillStyle = '#fff';
+      tctx.fillRect(0, 0, tmp.width, tmp.height);
+      framePaint(tctx, tmp.width, tmp.height);
+      tctx.drawImage(canvas, 0, 0);
+      source = tmp;
+    }
+    const bmp = canvasToMonoBmp(source);
+    // Multipart FormData mirrors the proven font-upload path: the firmware
+    // streams the file in small chunks via upload callbacks instead of
+    // materialising the whole 26KB body in one heap String (which on this
+    // RAM-tight ESP32-C3 contributed to a panic).
+    const blob = new Blob([bmp], { type: 'application/octet-stream' });
+    const formData = new FormData();
+    formData.append('file', blob, 'doodle.bmp');
+    try {
+      const res = await fetch('/api/crossslate/doodle', {
+        method: 'POST',
+        body: formData
+      });
+      console.log('[crossslate] send status', res.status);
+      const data = await res.json().catch(function() { return {}; });
+      if (res.ok) {
+        showMessage('Doodle sent to X4', false);
+        updateDoodleStatus(true);
+      } else {
+        showMessage(data.error || 'Send failed', true);
+      }
+    } catch (e) {
+      showMessage('Send failed', true);
+    }
+  }
+
+  async function deleteDoodle() {
+    try {
+      const res = await fetch('/api/crossslate/doodle/delete', { method: 'POST' });
+      const data = await res.json().catch(function() { return {}; });
+      if (res.ok) {
+        showMessage('Doodle deleted from X4', false);
+        updateDoodleStatus(false);
+      } else {
+        showMessage(data.error || 'Delete failed', true);
+      }
+    } catch (e) {
+      showMessage('Delete failed', true);
+    }
+  }
