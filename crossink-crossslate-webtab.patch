diff --git a/src/network/OtaAppProbe.h b/src/network/OtaAppProbe.h
new file mode 100644
index 0000000..c21239f
--- /dev/null
+++ b/src/network/OtaAppProbe.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ota_boot {
+
+// CrossSlate ships only for the XTEink X3/X4 (ESP32-C3). The alternate slot is
+// accepted only when its image targets this exact chip.
+constexpr uint16_t kCrossSlateChipId = 5;  // ESP_CHIP_ID_ESP32C3
+
+constexpr uint8_t kEspImageMagic = 0xE9;
+constexpr uint8_t kMaxEspImageSegments = 16;
+constexpr uint32_t kEspAppDescriptionMagic = 0xABCD5432;
+
+struct AppImageProbe {
+  uint8_t imageMagic;
+  uint8_t segmentCount;
+  uint16_t chipId;
+  uint32_t appDescriptionMagic;
+};
+
+constexpr bool isValidAlternateAppImage(const AppImageProbe& probe, const uint16_t requiredChipId) {
+  return probe.imageMagic == kEspImageMagic && probe.segmentCount > 0 && probe.segmentCount <= kMaxEspImageSegments &&
+         probe.chipId == requiredChipId && probe.appDescriptionMagic == kEspAppDescriptionMagic;
+}
+
+}  // namespace ota_boot
diff --git a/src/network/OtaBootSwitch.cpp b/src/network/OtaBootSwitch.cpp
index 7c3ca76..2190204 100644
--- a/src/network/OtaBootSwitch.cpp
+++ b/src/network/OtaBootSwitch.cpp
@@ -1,16 +1,71 @@
 #include "OtaBootSwitch.h"
 
 #include <Logging.h>
+#include <esp_app_format.h>
+#include <esp_ota_ops.h>
 #include <esp_rom_crc.h>
 #include <spi_flash_mmap.h>
 #include <string.h>
 
+#include "OtaAppProbe.h"
+
 namespace ota_boot {
 
 uint32_t computeSeqCrc(uint32_t seq) {
   return esp_rom_crc32_le(UINT32_MAX, reinterpret_cast<const uint8_t*>(&seq), kOtaSeqCrcLen);
 }
 
+const esp_partition_t* findValidAlternateApp() {
+  static_assert(kMaxEspImageSegments == ESP_IMAGE_MAX_SEGMENTS);
+
+  const esp_partition_t* running = esp_ota_get_running_partition();
+  if (!running) {
+    LOG_ERR("BOOT", "running app partition not found");
+    return nullptr;
+  }
+
+  const esp_partition_t* alternate = esp_ota_get_next_update_partition(running);
+  if (!alternate || alternate == running || alternate->type != ESP_PARTITION_TYPE_APP ||
+      alternate->subtype < ESP_PARTITION_SUBTYPE_APP_OTA_0 || alternate->subtype > ESP_PARTITION_SUBTYPE_APP_OTA_15) {
+    LOG_DBG("BOOT", "alternate OTA app partition not found");
+    return nullptr;
+  }
+
+  esp_image_header_t alternateHeader = {};
+  if (esp_partition_read(alternate, 0, &alternateHeader, sizeof(alternateHeader)) != ESP_OK) {
+    LOG_ERR("BOOT", "OTA app header read failed");
+    return nullptr;
+  }
+
+  // Read the immutable app descriptor directly. esp_ota_get_partition_description()
+  // in IDF 5 rejects an otherwise bootable IDF 4.4 image produced by CrossSlate.
+  // This matches the bounded header check used by CrossSlate itself.
+  constexpr size_t kAppDescOffset = sizeof(esp_image_header_t) + sizeof(esp_image_segment_header_t);
+  esp_app_desc_t alternateDescription = {};
+  if (kAppDescOffset + sizeof(alternateDescription) > alternate->size ||
+      esp_partition_read(alternate, kAppDescOffset, &alternateDescription, sizeof(alternateDescription)) != ESP_OK) {
+    LOG_DBG("BOOT", "alternate OTA app descriptor read failed");
+    return nullptr;
+  }
+
+  const AppImageProbe probe{
+      .imageMagic = alternateHeader.magic,
+      .segmentCount = alternateHeader.segment_count,
+      .chipId = static_cast<uint16_t>(alternateHeader.chip_id),
+      .appDescriptionMagic = alternateDescription.magic_word,
+  };
+  // CrossSlate is only shipped for the X3/X4 (ESP32-C3). Requiring the exact
+  // chip ID prevents offering the switch on S3 builds where a plausible S3
+  // image could sit in the alternate slot.
+  if (!isValidAlternateAppImage(probe, kCrossSlateChipId)) {
+    LOG_DBG("BOOT", "alternate OTA app image header is invalid");
+    return nullptr;
+  }
+
+  LOG_INF("BOOT", "valid alternate OTA app found in %s", alternate->label);
+  return alternate;
+}
+
 bool switchTo(const esp_partition_t* dest) {
   if (!dest) return false;
 
